# PrepXMentor frontend — environment variables
# Copy to frontend/.env.local and fill in real values. Never commit .env.local.

# --- Safepay payments (Next.js API routes under app/api/payment/) ---

# Safepay credentials from the Safepay dashboard.
SAFPAY_SECRET_KEY=
SAFPAY_PUBLIC_KEY=
# Webhook signature secret for verifying Safepay callbacks.
SAFPAY_WEBHOOK_SECRET=
# "sandbox" or "production". Defaults to sandbox if unset.
SAFPAY_ENVIRONMENT=sandbox

# --- Backend linkage ---

# Shared secret used by the payment webhook route to notify the backend
# (must match backend INTERNAL_SERVICE_SECRET).
INTERNAL_SERVICE_SECRET=
# Backend internal API base the webhook route calls
# (e.g. http://localhost:8000/api/v1).
BACKEND_INTERNAL_URL=http://localhost:8000/api/v1

# --- Public (client-visible) ---

# Backend API base used by the browser client.
# Defaults to http://localhost:8000/api/v1 if unset.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# Public app origin (checkout redirects, canonical URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public site origin used for blog SEO/canonical links.
# Defaults to https://www.prepxmentor.com if unset.
NEXT_PUBLIC_SITE_URL=
