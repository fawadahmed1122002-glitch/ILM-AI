# PrepXMentor backend — environment variables
# Copy to backend/.env and fill in real values. Never commit .env.

# --- Required ---

# Groq API key (https://console.groq.com). Startup fails loudly without it —
# explanations, MCQ generation and study chat all depend on it.
GROQ_API_KEY=

# Secret used to sign JWT auth tokens (HS256). Must NOT be the dev default;
# startup fails if unset or left at a known dev value. Generate with e.g.
# `openssl rand -hex 32`.
JWT_SECRET_KEY=

# --- Database ---

# PostgreSQL connection string (SQLAlchemy format).
# Defaults to a local dev database if unset:
#   postgresql+psycopg2://ilmai_user:ilmai_dev_password@localhost/ilmai_db
DATABASE_URL=

# --- Paths ---

# Root data directory (ChromaDB lives at <DATA_DIR>/chroma_db, response cache
# at <DATA_DIR>/cache.sqlite). Defaults to ./data relative to the process CWD.
DATA_DIR=./data

# --- Payments / internal service auth ---

# Shared secret the frontend payment webhook uses to notify the backend
# (constant-time compared). Must match frontend INTERNAL_SERVICE_SECRET.
INTERNAL_SERVICE_SECRET=

# --- Email verification (Resend) ---

# Resend API key (https://resend.com). Emails are skipped if unset.
RESEND_API_KEY=
# Verified sender address. Defaults to onboarding@resend.dev (Resend sandbox).
RESEND_SENDER_EMAIL=
# Deployed frontend origin used in verification email links
# (e.g. https://www.prepxmentor.com). Links break until set.
FRONTEND_URL=

# --- Optional: maintenance scripts only (backend/scripts/*) ---

# API_BASE=http://127.0.0.1:8000/api/v1
# REGEN_SLEEP=20
